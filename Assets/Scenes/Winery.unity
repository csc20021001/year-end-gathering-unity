  items:
  - itemName: "\u5C0F\u6728\u677F"
    icon: {fileID: 21300000, guid: db565d2897eb98d4981ecd8d425ada91, type: 3}
    shortDescription: "\u65C5\u9928\u4E2D\u767C\u73FE\u7684\u5C0F\u6728\u677F\u3002"
    detailedDescription: "\u904A\u6232\u4E2D\u7684\u5C0F\u6728\u677F\u662F\u539F\u5275\u6536\u96C6\u7269\u3002\u53EF\u5728\u6B64\u88DC\u5145\u7269\u4EF6\u4F86\u6E90\u8207\u5287\u60C5\u63CF\u8FF0\u3002"
  - itemName: "\u9999\u8549\u8449"
    icon: {fileID: 21300000, guid: 187af509319e2974a8cf68fcffe14719, type: 3}
    shortDescription: "\u5F9E\u5A46\u5A46\u624B\u4E2D\u53D6\u5F97\u7684\u9999\u8549\u8449\u3002"
    detailedDescription: "\u9999\u8549\u8449\u8207\u9999\u8549\u5047\u8396\u8449\u9798\u6240\u53D6\u5F97\u7684\u7E96\u7DAD\u4E0D\u540C\u3002\u8ACB\u5728\u6B64\u586B\u5BEB\u5DF2\u67E5\u8B49\u7684\u6587\u5316\u80CC\u666F\u8207\u904A\u6232\u8A2D\u8A08\u5DEE\u7570\u3002"
  - itemName: "\u5E74\u7CD5"
    icon: {fileID: 21300000, guid: 63f5cf97fbe05a146bf1279793b44127, type: 3}
    shortDescription: "\u89AA\u624B\u6417\u88FD\u7684\u7CEF\u7C73\u98DF\u54C1\u3002"
    detailedDescription: "\u672C\u4F5C\u7684\u6572\u64CA\u73A9\u6CD5\u662F\u904A\u6232\u5316\u8A2D\u8A08\uFF1B\u7CEF\u7C73\u7CD5\u3001\u9EBB\u7CEC\u53CA\u5E74\u7CD5\u7684\u540D\u7A31\u548C\u505A\u6CD5\u8ACB\u4F9D\u53EF\u9760\u4F86\u6E90\u6838\u5C0D\u3002"
  - itemName: "\u9152\u8207\u9152\u676F"
    icon: {fileID: 21300000, guid: 298e34d9e09d8314b89acb4e180798ad, type: 3}
    shortDescription: "\u91C0\u9152\u5E2B\u4EA4\u4ED8\u7684\u5DF2\u767C\u9175\u9152\u8207\u9152\u676F\u3002"
    detailedDescription: "\u904A\u6232\u4E2D\u7684\u4E94\u7F48\u6750\u6599\u6578\u91CF\u662F\u865B\u69CB\u914D\u65B9\u3002\u91C0\u9152\u8207\u796D\u5100\u76F8\u95DC\u80CC\u666F\u9808\u5340\u5206\u4E0D\u540C\u5BB6\u65CF\u7684\u5BE6\u969B\u505A\u6CD5\u3002"
  - itemName: "\u7CBE\u7DFB\u7684\u5C0F\u6728\u677F"
    icon: {fileID: 21300000, guid: dabb017fc1ffa654397f09c424b6a416, type: 3}
    shortDescription: "\u5728\u65C5\u9928\u5E8A\u5C3E\u767C\u73FE\u3001\u96D5\u5DE5\u7D30\u7DFB\u7684\u5C0F\u6728\u677F\u3002"
    detailedDescription: "\u96B1\u85CF\u7269\u54C1\uFF1A\u65C5\u9928\u5E8A\u5C3E\u767C\u73FE\u3002\u9019\u500B\u96D5\u523B\u662F\u904A\u6232\u865B\u69CB\u8A2D\u8A08\uFF0C\u4E0D\u5BA3\u7A31\u70BA\u771F\u5BE6\u5676\u746A\u862D\u6587\u7269\u3002"
  - itemName: "\u8108\u7D61\u5206\u660E\u7684\u9999\u8549\u8449"
    icon: {fileID: 21300000, guid: 28256386e67211141bc47e280ad0a156, type: 3}
    shortDescription: "\u8449\u8108\u6E05\u6670\u7684\u7279\u6B8A\u9999\u8549\u8449\u3002"
    detailedDescription: "\u96B1\u85CF\u7269\u54C1\uFF1A\u53D6\u5F97\u9999\u8549\u8449\u5F8C\uFF0C\u518D\u8207\u5A46\u5A46\u5C0D\u8A71\u4E94\u6B21\u3002\u8A73\u7D30\u6545\u4E8B\u5F85\u88DC\u5145\u3002"
  - itemName: "Q\u5F48\u7684\u5E74\u7CD5"
    icon: {fileID: 21300000, guid: acf61af80f571d849af5d5a07460ea29, type: 3}
    shortDescription: "\u5B8C\u6210\u5168\u7A0B\u5B8C\u7F8E\u6572\u64CA\u5F8C\u5F97\u5230\u7684\u5E74\u7CD5\u3002"
    detailedDescription: "\u96B1\u85CF\u7269\u54C1\uFF1A\u6574\u5834\u5E74\u7CD5\u5C0F\u904A\u6232\u6240\u6709\u6572\u64CA\u90FD\u9054\u6210 Perfect\u3002\u8A73\u7D30\u6545\u4E8B\u5F85\u88DC\u5145\u3002"
  - itemName: "\u6708\u5149\u7684\u9152\u8207\u9152\u676F"
    icon: {fileID: 21300000, guid: fae46dfb6783f98438bc91a6f3cbf326, type: 3}
    shortDescription: "\u5728\u9152\u7515\u9644\u8FD1\u627E\u5230\u7684\u7279\u6B8A\u9152\u8207\u9152\u676F\u3002"
    detailedDescription: "\u96B1\u85CF\u7269\u54C1\uFF1A\u9818\u53D6\u666E\u901A\u9152\u5F8C\uFF0C\u5728\u91C0\u9152\u574A\u7684\u9152\u7515\u65C1\u6309 E \u53D6\u5F97\u3002\u8A73\u7D30\u6545\u4E8B\u5F85\u88DC\u5145\u3002"
