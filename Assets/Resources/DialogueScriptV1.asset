%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d96b0759de1e4e74be96f5503987189d, type: 3}
  m_Name: DialogueScriptV1
  m_EditorClassIdentifier: 
  protagonistPortrait: {fileID: 21300000, guid: 3f55cec08ff44a644b3f87c004091f10, type: 3}
  grandmaPortrait: {fileID: 21300000, guid: fbbc1038675fd714aa38bd4bb843ed13, type: 3}
  brewerPortrait: {fileID: 21300000, guid: cc4c2a397bfe8354c96eeaf98da90020, type: 3}
  riceMasterPortrait: {fileID: 21300000, guid: 938bf38ef915e224d89c594d0a4f2241, type: 3}
  charactersPerSecond: 28
  commaPause: 0.1
  sentencePause: 0.22
  typingSound: {fileID: 8300000, guid: e35fb5d6545e0d24bb4beafd9a007b7b, type: 3}
  typingSoundVolume: 0.2
  typingSoundEveryNCharacters: 2
  conversations:
  - id: Opening
    lines:
    - speaker: 0
      text: "\u2026\u2026\u65E9\u4E0A\u4E86\u55CE\uFF1F"
    - speaker: 0
      text: "\u6628\u665A\u660E\u660E\u53EA\u662F\u6253\u7B97\u6574\u7406\u4E00\u4E0B\u9019\u5E7E\u5929\u8490\u96C6\u7684\u8CC7\u6599\uFF0C\u6C92\u60F3\u5230\u5C45\u7136\u76F4\u63A5\u7761\u8457\u4E86\u3002"
    - speaker: 0
      text: "\u9019\u5EA7\u805A\u843D\u4F3C\u4E4E\u6B63\u5728\u70BA\u6B72\u672B\u505A\u6E96\u5099\u3002\u4E00\u8DEF\u4E0A\u770B\u898B\u4E0D\u5C11\u4EBA\u5728\u5FD9\u788C\uFF0C\u53EF\u662F\u5927\u5BB6\u5C0D\u67D0\u4E9B\u4E8B\u60C5\u7684\u8AAA\u6CD5\uFF0C\u537B\u7E3D\u6709\u4E9B\u5FAE\u5999\u7684\u4E0D\u540C\u3002"
    - speaker: 0
      text: "\u5C24\u5176\u662F\u6628\u5929\u807D\u898B\u7684\u90A3\u500B\u6545\u4E8B\u2026\u2026\u7E3D\u89BA\u5F97\u9084\u6709\u4EC0\u9EBC\u5730\u65B9\u6C92\u6709\u5F04\u6E05\u695A\u3002"
    - speaker: 0
      text: "\u7B97\u4E86\uFF0C\u5149\u5F85\u5728\u623F\u9593\u88E1\u4E5F\u60F3\u4E0D\u51FA\u7B54\u6848\u3002"
    - speaker: 0
      text: "\u4ECA\u5929\u5C31\u518D\u5230\u805A\u843D\u88E1\u8D70\u8D70\u5427\u3002\u4E5F\u8A31\u80FD\u627E\u5230\u4E00\u4E9B\u503C\u5F97\u8A18\u9304\u7684\u6771\u897F\u3002"
  - id: Banana_Start
    lines:
    - speaker: 0
      text: "\u60A8\u597D\uFF0C\u6253\u64FE\u4E00\u4E0B\u3002\u8ACB\u554F\u9019\u88E1\u662F\u60A8\u7167\u9867\u7684\u9999\u8549\u5712\u55CE\uFF1F"
    - speaker: 1
      text: "\u662F\u554A\u3002\u600E\u9EBC\u4E86\uFF1F\u5E74\u8F15\u4EBA\uFF0C\u4F60\u5C0D\u9019\u4E9B\u9999\u8549\u6709\u8208\u8DA3\uFF1F"
    - speaker: 0
      text: "\u6211\u6B63\u5728\u8A18\u9304\u805A\u843D\u88E1\u7684\u751F\u6D3B\u548C\u50B3\u7D71\uFF0C\u525B\u624D\u770B\u898B\u9019\u88E1\u6709\u4E0D\u5C11\u9999\u8549\u690D\u682A\uFF0C\u6240\u4EE5\u60F3\u904E\u4F86\u770B\u770B\u3002"
    - speaker: 1
      text: "\u539F\u4F86\u5982\u6B64\u3002\u4F60\u53EF\u5225\u4EE5\u70BA\u9999\u8549\u5C31\u53EA\u662F\u62FF\u4F86\u5403\u7684\u6771\u897F\u3002"
    - speaker: 0
      text: "\u54A6\uFF1F\u96E3\u9053\u9084\u6709\u5176\u4ED6\u7528\u9014\u55CE\uFF1F"
    - speaker: 1
      text: "\u7576\u7136\u6709\u3002\u9999\u8549\u7684\u5047\u8396\u88E1\u6709\u53EF\u4EE5\u53D6\u51FA\u7684\u7E96\u7DAD\uFF0C\u53EA\u662F\u5F9E\u690D\u682A\u5230\u80FD\u4F7F\u7528\u7684\u6750\u6599\uFF0C\u53EF\u6C92\u4F60\u60F3\u5F97\u90A3\u9EBC\u7C21\u55AE\u3002"
    - speaker: 0
      text: "\u807D\u8D77\u4F86\u9700\u8981\u4E0D\u5C11\u5DE5\u592B\u3002"
    - speaker: 1
      text: "\u5149\u807D\u6211\u8AAA\uFF0C\u4F60\u5927\u6982\u4E5F\u8A18\u4E0D\u4F4F\u591A\u5C11\u3002\u600E\u9EBC\u6A23\uFF0C\u8981\u4E0D\u8981\u89AA\u81EA\u8A66\u8A66\uFF1F"
    - speaker: 0
      text: "\u5982\u679C\u4E0D\u6703\u7D66\u60A8\u6DFB\u9EBB\u7169\u7684\u8A71\uFF0C\u6211\u5F88\u6A02\u610F\u3002"
    - speaker: 1
      text: "\u5475\u5475\uFF0C\u90A3\u5C31\u5148\u5F9E\u6311\u9078\u5408\u9069\u7684\u690D\u682A\u958B\u59CB\u5427\u3002"
  - id: Banana_InProgress
    lines:
    - speaker: 1
      text: "\u6162\u6162\u4F86\uFF0C\u4E0D\u7528\u8457\u6025\u3002\u9019\u4E9B\u6750\u6599\u770B\u8D77\u4F86\u7C21\u55AE\uFF0C\u771F\u6B63\u52D5\u624B\u624D\u77E5\u9053\u8981\u6CE8\u610F\u7684\u5730\u65B9\u53EF\u591A\u8457\u5462\u3002"
    - speaker: 0
      text: "\u6211\u77E5\u9053\u4E86\uFF0C\u6211\u518D\u8A66\u8A66\u770B\u3002"
  - id: Banana_Reward
    lines:
    - speaker: 1
      text: "\u55EF\uFF0C\u505A\u5F97\u4E0D\u932F\u3002\u770B\u4F86\u4F60\u9084\u633A\u6709\u8010\u5FC3\u7684\u3002"
    - speaker: 0
      text: "\u6BD4\u60F3\u50CF\u4E2D\u56F0\u96E3\u591A\u4E86\u3002\u539F\u672C\u4EE5\u70BA\u53EA\u8981\u628A\u6750\u6599\u53D6\u4E0B\u4F86\u5C31\u597D\uFF0C\u6C92\u60F3\u5230\u5F8C\u9762\u9084\u6709\u90A3\u9EBC\u591A\u6B65\u9A5F\u3002"
    - speaker: 1
      text: "\u5F88\u591A\u4E8B\u60C5\u90FD\u662F\u9019\u6A23\u3002\u4F60\u53EA\u770B\u898B\u6700\u5F8C\u7684\u6210\u679C\uFF0C\u81EA\u7136\u4E0D\u77E5\u9053\u5176\u4E2D\u82B1\u4E86\u591A\u5C11\u5FC3\u601D\u3002"
    - speaker: 0
      text: "\u4ECA\u5929\u771F\u7684\u5B78\u5230\u4E86\u4E0D\u5C11\u6771\u897F\uFF0C\u8B1D\u8B1D\u60A8\u3002"
    - speaker: 1
      text: "\u5475\u5475\uFF0C\u65E2\u7136\u4F60\u9019\u9EBC\u8A8D\u771F\uFF0C\u9019\u7247\u9999\u8549\u8449\u5C31\u9001\u7D66\u4F60\u5427\u3002\u5E36\u8457\u5B83\uFF0C\u7576\u4F5C\u4ECA\u5929\u4F86\u904E\u9019\u88E1\u7684\u7D00\u5FF5\u3002"
    - speaker: 0
      text: "\u771F\u7684\u53EF\u4EE5\u55CE\uFF1F\u90A3\u6211\u5C31\u6536\u4E0B\u4E86\uFF01"
  - id: Banana_Extra_01
    lines:
    - speaker: 0
      text: "\u5A46\u5A46\uFF0C\u60A8\u5E73\u5E38\u90FD\u662F\u4E00\u500B\u4EBA\u7167\u9867\u9019\u7247\u9999\u8549\u5712\u55CE\uFF1F"
    - speaker: 1
      text: "\u5927\u90E8\u5206\u6642\u5019\u662F\u554A\u3002\u4E0D\u904E\u4EE5\u524D\u53EF\u71B1\u9B27\u4E86\uFF0C\u5E38\u6709\u4EBA\u4E00\u8D77\u4F86\u5E6B\u5FD9\u3002"
    - speaker: 0
      text: "\u73FE\u5728\u6BD4\u8F03\u5C11\u4EBA\u4F86\u4E86\u55CE\uFF1F"
    - speaker: 1
      text: "\u6BCF\u500B\u4EBA\u90FD\u6709\u81EA\u5DF1\u7684\u751F\u6D3B\u561B\u3002\u53EA\u662F\u5076\u723E\uFF0C\u9084\u662F\u6703\u61F7\u5FF5\u4EE5\u524D\u7684\u65E5\u5B50\u3002"
  - id: Banana_Extra_02
    lines:
    - speaker: 0
      text: "\u5A46\u5A46\uFF0C\u60A8\u70BA\u4EC0\u9EBC\u4E00\u76F4\u4F4F\u5728\u9019\u88E1\u5462\uFF1F"
    - speaker: 1
      text: "\u56E0\u70BA\u9019\u88E1\u6709\u592A\u591A\u6368\u4E0D\u5F97\u653E\u4E0B\u7684\u6771\u897F\u554A\u3002"
    - speaker: 0
      text: "\u662F\u6307\u9019\u5EA7\u9999\u8549\u5712\u55CE\uFF1F"
    - speaker: 1
      text: "\u9999\u8549\u5712\u4E5F\u662F\uFF0C\u9084\u6709\u90A3\u4E9B\u66FE\u7D93\u5728\u9019\u88E1\u751F\u6D3B\u904E\u7684\u4EBA\u3002"
  - id: Banana_Extra_03
    lines:
    - speaker: 1
      text: "\u5E74\u8F15\u4EBA\uFF0C\u4F60\u77E5\u9053\u55CE\uFF1F\u6709\u4E9B\u4E8B\u60C5\u554A\uFF0C\u5149\u9760\u66F8\u672C\u662F\u8A18\u4E0D\u4E0B\u4F86\u7684\u3002"
    - speaker: 0
      text: "\u70BA\u4EC0\u9EBC\u5462\uFF1F"
    - speaker: 1
      text: "\u56E0\u70BA\u4F60\u5F97\u89AA\u81EA\u53BB\u505A\uFF0C\u53BB\u807D\u4EBA\u8AAA\uFF0C\u624D\u6703\u660E\u767D\u5B83\u70BA\u4EC0\u9EBC\u91CD\u8981\u3002"
    - speaker: 0
      text: "\u2026\u2026\u6211\u60F3\uFF0C\u4ECA\u5929\u5DF2\u7D93\u7A0D\u5FAE\u61C2\u4E86\u4E00\u9EDE\u3002"
  - id: Banana_Extra_04
    lines:
    - speaker: 0
      text: "\u5A46\u5A46\uFF0C\u60A8\u4E00\u76F4\u90FD\u8A18\u5F97\u9019\u4E9B\u4E8B\u60C5\u55CE\uFF1F"
    - speaker: 1
      text: "\u4E5F\u4E0D\u5168\u662F\u3002\u6211\u4EE5\u524D\u4E5F\u662F\u8DDF\u8457\u9577\u8F29\u6162\u6162\u5B78\u7684\u3002"
    - speaker: 0
      text: "\u90A3\u60A8\u6703\u4E0D\u6703\u64D4\u5FC3\uFF0C\u6709\u4E00\u5929\u518D\u4E5F\u6C92\u6709\u4EBA\u8A18\u5F97\u4E86\uFF1F"
    - speaker: 1
      text: "\u2026\u2026\u7576\u7136\u6703\u3002"
    - speaker: 1
      text: "\u6240\u4EE5\u554A\uFF0C\u9084\u6709\u4EBA\u9858\u610F\u807D\uFF0C\u6211\u5C31\u9858\u610F\u7E7C\u7E8C\u8AAA\u3002"
  - id: Banana_Hidden
    lines:
    - speaker: 1
      text: "\u5E74\u8F15\u4EBA\uFF0C\u4F60\u4ECA\u5929\u4F86\u627E\u6211\u597D\u5E7E\u6B21\u4E86\u5462\u3002"
    - speaker: 0
      text: "\u554A\u2026\u2026\u4E0D\u597D\u610F\u601D\uFF0C\u6703\u4E0D\u6703\u6253\u64FE\u60A8\u5DE5\u4F5C\uFF1F"
    - speaker: 1
      text: "\u4E0D\u6703\uFF0C\u4E0D\u6703\u3002\u6211\u53EA\u662F\u5F88\u4E45\u6C92\u6709\u78B0\u5230\u50CF\u4F60\u9019\u9EBC\u611B\u554F\u554F\u984C\u7684\u4EBA\u4E86\u3002"
    - speaker: 1
      text: "\u4EE5\u524D\u4E5F\u6709\u500B\u5B69\u5B50\uFF0C\u7E3D\u559C\u6B61\u8DDF\u5728\u6211\u5F8C\u9762\u554F\u6771\u554F\u897F\u3002\u660E\u660E\u6709\u4E9B\u8A71\u807D\u904E\u597D\u591A\u904D\u4E86\uFF0C\u537B\u9084\u662F\u6703\u518D\u554F\u4E00\u6B21\u3002"
    - speaker: 0
      text: "\u807D\u8D77\u4F86\u662F\u500B\u5F88\u6709\u597D\u5947\u5FC3\u7684\u5B69\u5B50\u3002"
    - speaker: 1
      text: "\u662F\u554A\u2026\u2026"
    - speaker: 1
      text: "\u4F86\uFF0C\u9019\u7247\u8449\u5B50\u4E5F\u7D66\u4F60\u5427\u3002\u6211\u7279\u5225\u628A\u5B83\u4FDD\u5B58\u4E86\u4E0B\u4F86\uFF0C\u4F60\u770B\uFF0C\u4E0A\u982D\u7684\u8449\u8108\u662F\u4E0D\u662F\u5F88\u6E05\u695A\uFF1F"
    - speaker: 0
      text: "\u771F\u7684\u8036\u3002\u6BCF\u4E00\u689D\u7D0B\u8DEF\u90FD\u770B\u5F97\u5F88\u6E05\u695A\u3002"
    - speaker: 1
      text: "\u597D\u597D\u6536\u8457\u5427\u3002\u6709\u4E9B\u6771\u897F\u770B\u8D77\u4F86\u5F88\u666E\u901A\uFF0C\u4F46\u53EA\u8981\u4F60\u9858\u610F\u4ED4\u7D30\u770B\uFF0C\u5C31\u6703\u767C\u73FE\u5B83\u5011\u7559\u4E0B\u4E86\u8A31\u591A\u75D5\u8DE1\u3002"
    - speaker: 0
      text: "\u8B1D\u8B1D\u60A8\u3002\u6211\u6703\u597D\u597D\u4FDD\u5B58\u7684\u3002"
  - id: Banana_AfterHidden
    lines:
    - speaker: 1
      text: "\u6709\u7A7A\u5C31\u518D\u4F86\u5750\u5750\u5427\u3002\u9019\u88E1\u96D6\u7136\u6C92\u6709\u4EC0\u9EBC\u7279\u5225\u7684\uFF0C\u4F46\u6709\u7684\u662F\u6545\u4E8B\u53EF\u4EE5\u6162\u6162\u8AAA\u3002"
  - id: Winery_Start
    lines:
    - speaker: 0
      text: "\u60A8\u597D\uFF0C\u8ACB\u554F\u9019\u88E1\u662F\u5728\u91C0\u9152\u55CE\uFF1F"
    - speaker: 2
      text: "\u6C92\u932F\u3002\u600E\u9EBC\uFF0C\u4F60\u805E\u5230\u5473\u9053\u4E86\uFF1F"
    - speaker: 0
      text: "\u4E00\u8D70\u9032\u4F86\u5C31\u805E\u5230\u4E86\u3002\u4E0D\u904E\u9019\u88E1\u7684\u6750\u6599\u6BD4\u6211\u60F3\u50CF\u4E2D\u9084\u591A\u3002"
    - speaker: 2
      text: "\u91C0\u9152\u53EF\u4E0D\u662F\u628A\u6771\u897F\u96A8\u4FBF\u4E1F\u9032\u7F48\u5B50\u5C31\u80FD\u5B8C\u6210\u7684\u3002\u6750\u6599\u3001\u7528\u91CF\u548C\u7B49\u5F85\u7684\u6642\u9593\uFF0C\u90FD\u5F88\u91CD\u8981\u3002"
    - speaker: 0
      text: "\u807D\u8D77\u4F86\u9700\u8981\u4E0D\u5C11\u7D93\u9A57\u3002"
    - speaker: 2
      text: "\u7576\u7136\u3002\u4E0D\u904E\uFF0C\u4F60\u8981\u662F\u6709\u8208\u8DA3\uFF0C\u53EF\u4EE5\u5148\u5F9E\u6211\u6E96\u5099\u7684\u4E94\u7D44\u7DF4\u7FD2\u914D\u65B9\u958B\u59CB\u3002"
    - speaker: 0
      text: "\u4E94\u7D44\uFF1F\u6BCF\u4E00\u7D44\u90FD\u4E0D\u4E00\u6A23\u55CE\uFF1F"
    - speaker: 2
      text: "\u6C92\u932F\u3002\u4F60\u5F97\u7167\u8457\u63D0\u793A\u6311\u9078\u6750\u6599\uFF0C\u653E\u9032\u9152\u7F48\uFF0C\u6700\u5F8C\u78BA\u8A8D\u914D\u65B9\u3002"
    - speaker: 0
      text: "\u6211\u8A66\u8A66\u770B\uFF01"
    - speaker: 2
      text: "\u9084\u6709\u4E00\u4EF6\u4E8B\u8981\u8A18\u4F4F\u3002\u5C31\u7B97\u6750\u6599\u90FD\u653E\u597D\u4E86\uFF0C\u4E5F\u4E0D\u4EE3\u8868\u9152\u7ACB\u523B\u5C31\u80FD\u559D\u3002\u767C\u9175\u9084\u9700\u8981\u6642\u9593\u3002"
  - id: Winery_InProgress
    lines:
    - speaker: 2
      text: "\u914D\u65B9\u4E0D\u7528\u6025\u8457\u8A18\u5B8C\uFF0C\u5148\u770B\u6E05\u695A\u6750\u6599\u3002\u653E\u932F\u4E86\u5C31\u60F3\u60F3\u54EA\u4E00\u6B65\u51FA\u4E86\u554F\u984C\u3002"
    - speaker: 0
      text: "\u597D\uFF0C\u6211\u518D\u4ED4\u7D30\u78BA\u8A8D\u3002"
  - id: Winery_Reward
    lines:
    - speaker: 2
      text: "\u4E94\u7F48\u90FD\u5B8C\u6210\u4E86\uFF1F\u4E0D\u932F\u561B\uFF0C\u770B\u4F86\u4F60\u5B78\u5F97\u633A\u5FEB\u3002"
    - speaker: 0
      text: "\u7E3D\u7B97\u5B8C\u6210\u4E86\u3002\u4E0D\u904E\u9019\u4E9B\u9152\uFF0C\u73FE\u5728\u61C9\u8A72\u9084\u4E0D\u80FD\u559D\u5427\uFF1F"
    - speaker: 2
      text: "\u6C92\u932F\u3002\u4F60\u525B\u624D\u8ABF\u914D\u7684\u90A3\u4E9B\uFF0C\u9084\u5F97\u7D93\u904E\u767C\u9175\u8207\u7B49\u5F85\u3002"
    - speaker: 0
      text: "\u539F\u4F86\u5982\u6B64\u3002"
    - speaker: 2
      text: "\u4F86\uFF0C\u9019\u662F\u6211\u5148\u524D\u91C0\u597D\u3001\u5DF2\u7D93\u5B8C\u6210\u767C\u9175\u7684\u9152\uFF0C\u9023\u9152\u676F\u4E00\u8D77\u7D66\u4F60\u3002"
    - speaker: 0
      text: "\u771F\u7684\u55CE\uFF1F\u8B1D\u8B1D\u60A8\uFF01"
    - speaker: 2
      text: "\u4E0D\u7528\u5BA2\u6C23\u3002\u53EA\u5E0C\u671B\u4F60\u80FD\u8A18\u4F4F\uFF0C\u5F88\u591A\u6771\u897F\u90FD\u9700\u8981\u6642\u9593\u624D\u80FD\u5B8C\u6210\u3002"
  - id: Winery_AfterReward
    lines:
    - speaker: 0
      text: "\u91C0\u9152\u679C\u7136\u5F88\u9700\u8981\u8010\u5FC3\u5462\u3002"
    - speaker: 2
      text: "\u662F\u554A\u3002\u8457\u6025\u4E5F\u6C92\u6709\u7528\uFF0C\u8A72\u7B49\u5F85\u7684\u6642\u5019\uFF0C\u5C31\u5F97\u597D\u597D\u7B49\u5F85\u3002"
  - id: Rice_Start
    lines:
    - speaker: 0
      text: "\u60A8\u597D\uFF01\u9019\u88E1\u662F\u5728\u505A\u5E74\u7CD5\u55CE\uFF1F"
    - speaker: 3
      text: "\u662F\u554A\u3002\u6B63\u597D\u6E96\u5099\u958B\u59CB\u6417\u7CD5\uFF0C\u4F60\u4F86\u5F97\u771F\u5DE7\u3002"
    - speaker: 0
      text: "\u539F\u4F86\u662F\u9019\u6A23\u88FD\u4F5C\u7684\u554A\u3002\u6211\u53EF\u4EE5\u5728\u65C1\u908A\u770B\u770B\u55CE\uFF1F"
    - speaker: 3
      text: "\u5149\u770B\u591A\u6C92\u610F\u601D\uFF0C\u8981\u4E0D\u8981\u89AA\u81EA\u8A66\u8A66\uFF1F"
    - speaker: 0
      text: "\u54A6\uFF1F\u6211\u5F9E\u4F86\u6C92\u6709\u505A\u904E\uFF0C\u9019\u6A23\u771F\u7684\u6C92\u554F\u984C\u55CE\uFF1F"
    - speaker: 3
      text: "\u54C8\u54C8\uFF0C\u8AB0\u4E0D\u662F\u5F9E\u7B2C\u4E00\u6B21\u958B\u59CB\u5B78\u7684\uFF1F\u91CD\u9EDE\u4E0D\u662F\u529B\u6C23\u6709\u591A\u5927\uFF0C\u800C\u662F\u7BC0\u594F\u8981\u6293\u5F97\u6E96\u3002"
    - speaker: 0
      text: "\u7BC0\u594F\uFF1F"
    - speaker: 3
      text: "\u5C0D\u3002\u770B\u6E96\u6642\u6A5F\u843D\u4E0B\uFF0C\u7B49\u5230\u9700\u8981\u7FFB\u52D5\u7684\u6642\u5019\u518D\u7FFB\u3002\u4E0D\u80FD\u5149\u9760\u883B\u529B\u3002"
    - speaker: 0
      text: "\u6211\u660E\u767D\u4E86\uFF0C\u90A3\u5C31\u8B93\u6211\u8A66\u8A66\u5427\uFF01"
  - id: Rice_InProgress
    lines:
    - speaker: 3
      text: "\u4E0D\u8981\u592A\u5FC3\u6025\uFF0C\u4ED4\u7D30\u770B\u6E96\u7BC0\u594F\u518D\u6572\u3002"
    - speaker: 0
      text: "\u597D\uFF0C\u6211\u6703\u6CE8\u610F\u7684\u3002"
  - id: Rice_Reward
    lines:
    - speaker: 3
      text: "\u5B8C\u6210\u5566\uFF01\u7B2C\u4E00\u6B21\u505A\u5C31\u80FD\u505A\u5230\u9019\u6A23\uFF0C\u5DF2\u7D93\u5F88\u4E0D\u932F\u4E86\u3002"
    - speaker: 0
      text: "\u547C\u2026\u2026\u6C92\u60F3\u5230\u6BD4\u770B\u8D77\u4F86\u9084\u8981\u7D2F\u3002"
    - speaker: 3
      text: "\u54C8\u54C8\uFF0C\u9019\u5C31\u662F\u81EA\u5DF1\u52D5\u624B\u505A\u7684\u6ECB\u5473\u3002"
    - speaker: 0
      text: "\u4E0D\u904E\uFF0C\u770B\u8457\u5B83\u6162\u6162\u8B8A\u6210\u73FE\u5728\u9019\u500B\u6A23\u5B50\uFF0C\u78BA\u5BE6\u5F88\u6709\u6210\u5C31\u611F\u3002"
    - speaker: 3
      text: "\u4F86\uFF0C\u9019\u4EFD\u5E74\u7CD5\u7D66\u4F60\uFF0C\u7B97\u662F\u4ECA\u5929\u52AA\u529B\u7684\u6210\u679C\u3002"
    - speaker: 0
      text: "\u8B1D\u8B1D\uFF01\u6211\u6703\u597D\u597D\u6536\u4E0B\u7684\u3002"
  - id: Rice_PerfectBonus
    lines:
    - speaker: 3
      text: "\u7B49\u7B49\uFF0C\u6211\u518D\u4ED4\u7D30\u770B\u770B\u2026\u2026"
    - speaker: 0
      text: "\u600E\u9EBC\u4E86\uFF1F\u96E3\u9053\u54EA\u88E1\u505A\u932F\u4E86\u55CE\uFF1F"
    - speaker: 3
      text: "\u4E0D\u662F\u4E0D\u662F\uFF01\u6070\u597D\u76F8\u53CD\uFF0C\u4F60\u9019\u6B21\u7684\u7BC0\u594F\u638C\u63E1\u5F97\u7279\u5225\u597D\u3002"
    - speaker: 3
      text: "\u9019\u4EFD\u5E74\u7CD5\u7684\u53E3\u611F\u61C9\u8A72\u6703\u5F88\u4E0D\u932F\u3002\u65E2\u7136\u662F\u4F60\u89AA\u624B\u5B8C\u6210\u7684\uFF0C\u5C31\u9023\u9019\u4EFD\u4E00\u8D77\u5E36\u8D70\u5427\uFF01"
    - speaker: 0
      text: "\u771F\u7684\u55CE\uFF1F\u592A\u8B1D\u8B1D\u60A8\u4E86\uFF01"
  - id: Rice_Reward_Perfect
    lines:
    - speaker: 3
      text: "\u5B8C\u6210\u5566\uFF01\u7B2C\u4E00\u6B21\u505A\u5C31\u80FD\u505A\u5230\u9019\u6A23\uFF0C\u5DF2\u7D93\u5F88\u4E0D\u932F\u4E86\u3002"
    - speaker: 0
      text: "\u547C\u2026\u2026\u6C92\u60F3\u5230\u6BD4\u770B\u8D77\u4F86\u9084\u8981\u7D2F\u3002"
    - speaker: 3
      text: "\u54C8\u54C8\uFF0C\u9019\u5C31\u662F\u81EA\u5DF1\u52D5\u624B\u505A\u7684\u6ECB\u5473\u3002"
    - speaker: 0
      text: "\u4E0D\u904E\uFF0C\u770B\u8457\u5B83\u6162\u6162\u8B8A\u6210\u73FE\u5728\u9019\u500B\u6A23\u5B50\uFF0C\u78BA\u5BE6\u5F88\u6709\u6210\u5C31\u611F\u3002"
    - speaker: 3
      text: "\u4F86\uFF0C\u9019\u4EFD\u5E74\u7CD5\u7D66\u4F60\uFF0C\u7B97\u662F\u4ECA\u5929\u52AA\u529B\u7684\u6210\u679C\u3002"
    - speaker: 0
      text: "\u8B1D\u8B1D\uFF01\u6211\u6703\u597D\u597D\u6536\u4E0B\u7684\u3002"
    - speaker: 3
      text: "\u7B49\u7B49\uFF0C\u6211\u518D\u4ED4\u7D30\u770B\u770B\u2026\u2026"
    - speaker: 0
      text: "\u600E\u9EBC\u4E86\uFF1F\u96E3\u9053\u54EA\u88E1\u505A\u932F\u4E86\u55CE\uFF1F"
    - speaker: 3
      text: "\u4E0D\u662F\u4E0D\u662F\uFF01\u6070\u597D\u76F8\u53CD\uFF0C\u4F60\u9019\u6B21\u7684\u7BC0\u594F\u638C\u63E1\u5F97\u7279\u5225\u597D\u3002"
    - speaker: 3
      text: "\u9019\u4EFD\u5E74\u7CD5\u7684\u53E3\u611F\u61C9\u8A72\u6703\u5F88\u4E0D\u932F\u3002\u65E2\u7136\u662F\u4F60\u89AA\u624B\u5B8C\u6210\u7684\uFF0C\u5C31\u9023\u9019\u4EFD\u4E00\u8D77\u5E36\u8D70\u5427\uFF01"
    - speaker: 0
      text: "\u771F\u7684\u55CE\uFF1F\u592A\u8B1D\u8B1D\u60A8\u4E86\uFF01"
  - id: Rice_AfterReward
    lines:
    - speaker: 3
      text: "\u4E0B\u6B21\u6709\u6A5F\u6703\u518D\u4F86\u8A66\u8A66\u5427\u3002\u591A\u7DF4\u5E7E\u6B21\uFF0C\u8AAA\u4E0D\u5B9A\u5C31\u80FD\u638C\u63E1\u81EA\u5DF1\u7684\u7BC0\u594F\u4E86\u3002"
    - speaker: 0
      text: "\u597D\uFF0C\u6709\u6A5F\u6703\u6211\u4E00\u5B9A\u518D\u4F86\uFF01"
  - id: Final_Plank
    lines:
    - speaker: 0
      text: "\u5C0F\u6728\u677F\u2026\u2026\u539F\u672C\u53EA\u662F\u65C5\u9928\u623F\u9593\u88E1\u7684\u4E00\u4EF6\u5C0F\u6771\u897F\u3002"
    - speaker: 0
      text: "\u5982\u4ECA\u653E\u5230\u9019\u88E1\uFF0C\u537B\u83AB\u540D\u8B93\u4EBA\u89BA\u5F97\u5B83\u8207\u5176\u4ED6\u7269\u4EF6\u4E4B\u9593\u6709\u8457\u67D0\u7A2E\u806F\u7E6B\u3002"
  - id: Final_Leaf
    lines:
    - speaker: 0
      text: "\u9999\u8549\u8449\u3002\u60F3\u8D77\u5A46\u5A46\u7684\u8A71\uFF0C\u5F88\u591A\u4E8B\u60C5\u53EA\u770B\u6210\u679C\uFF0C\u662F\u4E0D\u6703\u77E5\u9053\u5176\u4E2D\u82B1\u4E86\u591A\u5C11\u5FC3\u601D\u7684\u3002"
  - id: Final_Rice
    lines:
    - speaker: 0
      text: "\u9019\u4EFD\u5E74\u7CD5\u8B93\u6211\u60F3\u8D77\u5E97\u5BB6\u6559\u6211\u7684\u6572\u64CA\u7BC0\u594F\u3002\u91CD\u8981\u7684\u4F3C\u4E4E\u4E0D\u53EA\u662F\u6210\u54C1\uFF0C\u9084\u6709\u88FD\u4F5C\u5B83\u7684\u4EBA\u3002"
  - id: Final_Wine
    lines:
    - speaker: 0
      text: "\u6700\u5F8C\u662F\u9152\u8207\u9152\u676F\u3002\u91C0\u9152\u5E2B\u8AAA\u904E\uFF0C\u6709\u4E9B\u4E8B\u60C5\u9700\u8981\u6642\u9593\u7B49\u5F85\u3002"
    - speaker: 0
      text: "\u5C0F\u6728\u677F\u3001\u9999\u8549\u8449\u3001\u5E74\u7CD5\uFF0C\u9084\u6709\u9152\u8207\u9152\u676F\u2026\u2026\u56DB\u6A23\u6771\u897F\u90FD\u653E\u5728\u4E00\u8D77\u4E86\u3002"
    - speaker: 0
      text: "\u6216\u8A31\u91CD\u8981\u7684\uFF0C\u4E0D\u53EA\u662F\u9019\u4E9B\u7269\u54C1\u672C\u8EAB\uFF0C\u800C\u662F\u90A3\u4E9B\u66FE\u7D93\u88FD\u4F5C\u5B83\u5011\u3001\u4F7F\u7528\u5B83\u5011\uFF0C\u4EE5\u53CA\u5C07\u6545\u4E8B\u50B3\u4E0B\u4F86\u7684\u4EBA\u3002"
    - speaker: 0
      text: "\u2026\u2026\u5168\u90E8\u653E\u597D\u4E86\u3002\u660E\u660E\u61C9\u8A72\u662F\u7B2C\u4E00\u6B21\u770B\u898B\u9019\u6A23\u7684\u666F\u8C61\uFF0C\u5FC3\u88E1\u537B\u6709\u4E00\u7A2E\u8AAA\u4E0D\u51FA\u7684\u719F\u6089\u611F\u3002"
    - speaker: 0
      text: "\u6211\u4F86\u5230\u9019\u88E1\uFF0C\u771F\u7684\u662F\u55AE\u7D14\u70BA\u4E86\u7814\u7A76\u55CE\uFF1F\u9084\u662F\u8AAA\u2026\u2026\u6211\u5176\u5BE6\u4E00\u76F4\u5728\u5C0B\u627E\u67D0\u500B\u65E9\u5C31\u907A\u5FD8\u7684\u7B54\u6848\uFF1F"
  - id: Final_Placement
    lines:
    - speaker: 0
      text: "\u5C0F\u6728\u677F\u2026\u2026\u539F\u672C\u53EA\u662F\u65C5\u9928\u623F\u9593\u88E1\u7684\u4E00\u4EF6\u5C0F\u6771\u897F\u3002"
    - speaker: 0
      text: "\u5982\u4ECA\u653E\u5230\u9019\u88E1\uFF0C\u537B\u83AB\u540D\u8B93\u4EBA\u89BA\u5F97\u5B83\u8207\u5176\u4ED6\u7269\u4EF6\u4E4B\u9593\u6709\u8457\u67D0\u7A2E\u806F\u7E6B\u3002"
    - speaker: 0
      text: "\u9999\u8549\u8449\u3002\u60F3\u8D77\u5A46\u5A46\u7684\u8A71\uFF0C\u5F88\u591A\u4E8B\u60C5\u53EA\u770B\u6210\u679C\uFF0C\u662F\u4E0D\u6703\u77E5\u9053\u5176\u4E2D\u82B1\u4E86\u591A\u5C11\u5FC3\u601D\u7684\u3002"
    - speaker: 0
      text: "\u9019\u4EFD\u5E74\u7CD5\u8B93\u6211\u60F3\u8D77\u5E97\u5BB6\u6559\u6211\u7684\u6572\u64CA\u7BC0\u594F\u3002\u91CD\u8981\u7684\u4F3C\u4E4E\u4E0D\u53EA\u662F\u6210\u54C1\uFF0C\u9084\u6709\u88FD\u4F5C\u5B83\u7684\u4EBA\u3002"
    - speaker: 0
      text: "\u6700\u5F8C\u662F\u9152\u8207\u9152\u676F\u3002\u91C0\u9152\u5E2B\u8AAA\u904E\uFF0C\u6709\u4E9B\u4E8B\u60C5\u9700\u8981\u6642\u9593\u7B49\u5F85\u3002"
    - speaker: 0
      text: "\u5C0F\u6728\u677F\u3001\u9999\u8549\u8449\u3001\u5E74\u7CD5\uFF0C\u9084\u6709\u9152\u8207\u9152\u676F\u2026\u2026\u56DB\u6A23\u6771\u897F\u90FD\u653E\u5728\u4E00\u8D77\u4E86\u3002"
    - speaker: 0
      text: "\u6216\u8A31\u91CD\u8981\u7684\uFF0C\u4E0D\u53EA\u662F\u9019\u4E9B\u7269\u54C1\u672C\u8EAB\uFF0C\u800C\u662F\u90A3\u4E9B\u66FE\u7D93\u88FD\u4F5C\u5B83\u5011\u3001\u4F7F\u7528\u5B83\u5011\uFF0C\u4EE5\u53CA\u5C07\u6545\u4E8B\u50B3\u4E0B\u4F86\u7684\u4EBA\u3002"
    - speaker: 0
      text: "\u2026\u2026\u5168\u90E8\u653E\u597D\u4E86\u3002\u660E\u660E\u61C9\u8A72\u662F\u7B2C\u4E00\u6B21\u770B\u898B\u9019\u6A23\u7684\u666F\u8C61\uFF0C\u5FC3\u88E1\u537B\u6709\u4E00\u7A2E\u8AAA\u4E0D\u51FA\u7684\u719F\u6089\u611F\u3002"
    - speaker: 0
      text: "\u6211\u4F86\u5230\u9019\u88E1\uFF0C\u771F\u7684\u662F\u55AE\u7D14\u70BA\u4E86\u7814\u7A76\u55CE\uFF1F\u9084\u662F\u8AAA\u2026\u2026\u6211\u5176\u5BE6\u4E00\u76F4\u5728\u5C0B\u627E\u67D0\u500B\u65E9\u5C31\u907A\u5FD8\u7684\u7B54\u6848\uFF1F"
  - id: Final_Complete
    lines:
    - speaker: 0
      text: "\u2026\u2026\u5168\u90E8\u653E\u597D\u4E86\u3002\u660E\u660E\u61C9\u8A72\u662F\u7B2C\u4E00\u6B21\u770B\u898B\u9019\u6A23\u7684\u666F\u8C61\uFF0C\u5FC3\u88E1\u537B\u6709\u4E00\u7A2E\u8AAA\u4E0D\u51FA\u7684\u719F\u6089\u611F\u3002"
    - speaker: 0
      text: "\u6211\u4F86\u5230\u9019\u88E1\uFF0C\u771F\u7684\u662F\u55AE\u7D14\u70BA\u4E86\u7814\u7A76\u55CE\uFF1F\u9084\u662F\u8AAA\u2026\u2026\u6211\u5176\u5BE6\u4E00\u76F4\u5728\u5C0B\u627E\u67D0\u500B\u65E9\u5C31\u907A\u5FD8\u7684\u7B54\u6848\uFF1F"
